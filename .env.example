# Copy this file to .env and fill in your values. .env is gitignored.
# Used by sync-to-router.sh and backup-logs.sh.

# Router address. The sync script also accepts it as its first argument.
ROUTER_IP=192.168.1.1
ROUTER_USER=root

# Router admin password (FreshTomato web UI / SSH).
ROUTER_PASS=change-me
