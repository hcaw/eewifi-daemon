#
# eewifi-daemon.config.example
#
# Copy this file to /jffs/eewifi-daemon.config on your router
# The actual config with credentials is excluded from git via .gitignore
#

# EE WiFi login credentials
USERNAME="your-email@example.com"
PASSWORD="your-password"

# Debug mode - set to true for verbose output
DEBUG=false

# Timing configuration (in seconds)
DELAY_INTERFACE=2       # Delay between SSID checks when not on EE WiFi
DELAY_LOGIN_ATTEMPTS=5  # Delay between failed login retries
DELAY_SUCCESS=60        # Delay between checks when logged in successfully
WGET_TIMEOUT=5          # HTTP request timeout

# EE WiFi server (should not need changing)
SERVER="https://ee-wifi.ee.co.uk"